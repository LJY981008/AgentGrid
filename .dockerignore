# 빌드 컨텍스트 최소화 — 이미지에 안 들어가고 캐시 무효화도 줄임
# (호스트 .venv 를 가져가면 플랫폼 불일치로 깨짐 → 반드시 제외)

# 가상환경 / 파이썬 캐시
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# 린트·타입·테스트 캐시
.ruff_cache/
.mypy_cache/
.pytest_cache/

# 버전관리 / CI
.git/
.github/
.gitignore

# 데이터 (벌크 Parquet·로컬 캐시 — 이미지에 불필요, 대용량)
data/
*.parquet

# 프론트엔드 (web 서비스는 node:22 이미지 + ./webapp 바인드로 동작 — app 이미지엔 불필요)
webapp/node_modules/
webapp/dist/

# 문서 / 옵시디언 볼트 (런타임 불필요)
docs/
*.md
!README.md

# Claude Code 하네스 / 로컬 도구 (런타임 불필요)
.claude/
.omc/
.playwright-mcp/

# IDE / OS
.vscode/
.idea/
*.iml
.DS_Store
*.log

# 시크릿 / 로컬 env (이미지에 굽지 않음)
.env
.env.local

# Docker 자체
Dockerfile
.dockerignore
compose.yaml
