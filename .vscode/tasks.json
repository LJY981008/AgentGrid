{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "infra: up (PostgreSQL)",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "infra: down",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "lint (ruff)",
      "type": "shell",
      "command": "ruff check src tests",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "typecheck (mypy)",
      "type": "shell",
      "command": "mypy",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "test (pytest)",
      "type": "shell",
      "command": "PYTHONPATH=src pytest -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "hooks: 회귀 테스트",
      "type": "shell",
      "command": ".claude/hooks/tests/run.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
