{
  "uid": "agentgrid-backend",
  "title": "Agent Grid — Backend",
  "tags": ["agentgrid", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP 요청 처리율 (req/s, by uri)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"agentgrid-backend\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 지연 (s, by uri)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"agentgrid-backend\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM Heap 사용량",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"agentgrid-backend\", area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{application=\"agentgrid-backend\", area=\"heap\"})",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU 사용률",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "targets": [
        { "expr": "process_cpu_usage{application=\"agentgrid-backend\"}", "legendFormat": "process" },
        { "expr": "system_cpu_usage{application=\"agentgrid-backend\"}", "legendFormat": "system" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "에러 로그 (logback events/s)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (level) (rate(logback_events_total{application=\"agentgrid-backend\", level=~\"error|warn\"}[5m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hikari DB 커넥션",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"agentgrid-backend\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{application=\"agentgrid-backend\"}", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending{application=\"agentgrid-backend\"}", "legendFormat": "pending" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RabbitMQ 발행/소비 (도메인 작업 시작 후 메트릭 노출)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (queue) (rate(rabbitmq_consumed_total{application=\"agentgrid-backend\"}[5m]))",
          "legendFormat": "consumed {{queue}}"
        },
        {
          "expr": "sum(rate(rabbitmq_published_total{application=\"agentgrid-backend\"}[5m]))",
          "legendFormat": "published"
        }
      ]
    }
  ]
}
