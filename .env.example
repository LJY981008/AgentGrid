# Agent Grid 환경변수 템플릿 — 실제 값은 .env (gitignore 됨)
# 로컬 인프라 기본값은 compose.yaml 에 하드코딩 (agentgrid / agentgrid-local) — 로컬은 .env 불필요.
# 아래는 추후 기능 구현 시 필요해지는 키 (2nd_plan 기준 예상):

# --- 분석 파이프라인 (구현 시) ---
# GitHub repo 클론/메타데이터 조회용 (rate limit 완화)
# GITHUB_TOKEN=

# LLM 보정 분석용 (하이브리드 등급 산출 — 2nd_plan §4)
# ANTHROPIC_API_KEY=

# --- 운영 배포 시 ---
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_RABBITMQ_USERNAME=
# SPRING_RABBITMQ_PASSWORD=
