# stockpick 환경변수 템플릿 — 실제 값은 .env (gitignore 됨)
# 로컬 인프라 기본값은 compose.yaml 에 하드코딩 (stockpick / stockpick-local) — 로컬은 .env 불필요.

# --- 데이터 소스 (M1) ---
# KRX OpenAPI 인증키 (일일 증분 갱신 — 공식, 무료 신청: openapi.krx.co.kr)
# KRX_API_KEY=
# 한국투자 KIS Developers (검증·미래 자동화 — 무료, 계좌 필요)
# KIS_APP_KEY=
# KIS_APP_SECRET=
# (FinanceDataReader·pykrx 벌크 수집은 키 불필요)

# --- 운영 배포 시 ---
# DATABASE_URL=postgresql://...

# --- 미래(AI 자동화, 우선순위 낮음) ---
# ANTHROPIC_API_KEY=
