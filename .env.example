# stockpick 환경변수 템플릿 — 실제 값은 .env (gitignore 됨)
# 로컬 인프라 기본값은 compose.yaml 에 하드코딩 (stockpick / stockpick-local) — 로컬은 .env 불필요.

# --- 데이터 소스 (미국, ADR-002/003) ---
# 가격: Tiingo (M1 파일럿) — https://www.tiingo.com (무료 토큰)
# TIINGO_API_KEY=
# 가격: EODHD (M2 본격, 폐지종목 포함 — ADR-003) — https://eodhd.com
# EODHD_API_KEY=
# 재무: SEC EDGAR (filed=PIT, edgartools) — API 키 불필요(공개 데이터).
#   단 SEC 공정접근 정책상 요청 User-Agent 에 신원(이름+이메일) 필수 — 비밀 아님(연락처).
#   edgartools 가 이 값을 매 요청 헤더에 자동 삽입. .env 에 본인 실제 이메일로 채울 것.
# EDGAR_IDENTITY=Hong Gildong your-email@example.com

# --- 운영 배포 시 ---
# DATABASE_URL=postgresql://...

# --- 미래(AI 자동화, 우선순위 낮음) ---
# ANTHROPIC_API_KEY=
