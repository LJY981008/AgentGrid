{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(python3:*)",
      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(jq:*)",
      "Read(//tmp/**)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:t.me)"
    ],
    "deny": [
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)"
    ]
  },
  "claudeMdExcludes": [
    "**/.venv/**",
    "**/__pycache__/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.pytest_cache/**",
    "**/node_modules/**",
    "**/.omc/**"
  ]
}
